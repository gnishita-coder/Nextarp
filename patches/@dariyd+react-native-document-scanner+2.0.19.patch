+    CIImage *ciImage = [[CIImage alloc] initWithCGImage:normalized.CGImage];
+    VNImageRequestHandler *handler = [[VNImageRequestHandler alloc] initWithCGImage:normalized.CGImage options:@{}];
+    VNRectangleObservation *bestObservation = nil;
