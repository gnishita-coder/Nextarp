+            id result = rectRequest.results.firstObject;
+            if ([result isKindOfClass:[VNRectangleObservation class]]) {
+                bestObservation = (VNRectangleObservation *)result;
+            }
+        }
+    }
+
+    if (!bestObservation) {
+        return normalized;
+    }
