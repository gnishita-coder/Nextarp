+/**
+ * Crop + perspective-correct a single camera photo. Tries document
+ * segmentation first, then rectangle detection as a fallback.
+ */
+- (UIImage *)cropDocumentIfPossible:(UIImage *)image
+{
+    UIImage *normalized = [self normalizedImage:image];
+    if (!normalized || !normalized.CGImage) {
+        return image;
+    }
